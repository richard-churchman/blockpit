<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <RootNamespace>Blockpit.Api</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentMigrator" Version="7.2.0"/>
        <PackageReference Include="FluentMigrator.Runner.Core" Version="7.2.0"/>
        <PackageReference Include="FluentMigrator.Runner.SQLite" Version="7.2.0"/>
        <PackageReference Include="log4net" Version="3.2.0"/>
        <PackageReference Include="MediatR" Version="14.0.0"/>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.1"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Log4Net.AspNetCore" Version="8.0.0"/>
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.0"/>
    </ItemGroup>

    <ItemGroup>
        <Content Update="Mock\Btc.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Update="Mock\Dash.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Update="Mock\Eth.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\.dockerignore">
            <Link>.dockerignore</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Blockpit.Configuration\Blockpit.Configuration.csproj"/>
        <ProjectReference Include="..\Blockpit.Data\Blockpit.Data.csproj"/>
        <ProjectReference Include="..\Blockpit.Listener\Blockpit.Listener.csproj"/>
        <ProjectReference Include="..\Blockpit.Migrations\Blockpit.Migrations.csproj"/>
        <ProjectReference Include="..\Blockpit.Observability\Blockpit.Observability.csproj"/>
        <ProjectReference Include="..\Blockpit.Query\Blockpit.Query.csproj"/>
    </ItemGroup>

</Project>
